# ── Base de Datos (Supabase) ──────────────────────────────────
# Conexión al pooler (Transaction mode) — para queries normales
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa — solo para prisma migrate (NO usar en producción para queries)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ── NextAuth ──────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET="tu-secreto-aqui-de-32-caracteres-o-mas"
AUTH_URL="http://localhost:3000"

# ── Resend (emails transaccionales) ──────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Droguería Central <notificaciones@tu-dominio.com>"
