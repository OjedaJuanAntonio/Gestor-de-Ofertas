# Copiá este archivo a .env.local y completá los valores:
#   cp .env.example .env.local

# ── Base de datos ───────────────────────────────────────────
# Por defecto apunta al Postgres de docker-compose.yml (local).
# En producción, reemplazá por Neon/Supabase:
#   - DATABASE_URL = pooler (ej. Supabase puerto 6543, ?pgbouncer=true&connection_limit=1)
#   - DIRECT_URL   = conexión directa (puerto 5432), usada por las migraciones
DATABASE_URL="postgresql://gestor:gestor_dev@localhost:5432/gestor_ofertas"
DIRECT_URL="postgresql://gestor:gestor_dev@localhost:5432/gestor_ofertas"

# ── NextAuth ────────────────────────────────────────────────
# Generá el secreto con: openssl rand -base64 32
AUTH_SECRET="cambiame-por-un-secreto-de-32-caracteres-o-mas"
AUTH_URL="http://localhost:3000"

# ── Resend (correos transaccionales) ────────────────────────
# En local dejá EMAIL_DRY_RUN=true: no envía, solo loguea en consola.
# En producción: EMAIL_DRY_RUN=false + RESEND_API_KEY + RESEND_FROM_EMAIL.
EMAIL_DRY_RUN="true"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Droguería Central <onboarding@resend.dev>"

# ── Cron de la cola de correos ──────────────────────────────
# Secreto para autorizar POST /api/cron/outbox (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""
